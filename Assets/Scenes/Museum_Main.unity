  audioSource: {fileID: 0}
  narrationClip: {fileID: 8300000, guid: 8c6230b6940b5534d9673767d78c02fc, type: 3}
  exhibitPanel: {fileID: 381415109}
  exhibitStory: {fileID: 11400000, guid: 4aebcb83860b38c4bb5afe00f64b29b0, type: 2}
  animalData:
    animalName: The Dodo
    scientificName: Raphus cucullatus
    status: EXTINCT
    pages:
    - content: The Dodo was a flightless bird endemic to the island of Mauritius
        in the Indian Ocean. Standing about 1 meter tall and weighing up to 18 kg,
        it lived peacefully in forests, nesting on the ground and feeding on fallen
        fruits.
    - content: When Dutch sailors arrived in 1598, the dodo had no natural fear of
        humans. Sailors hunted them for food, but the main blow was the introduction
        of invasive species (pigs, rats, monkeys) that destroyed the dodo's ground
        nests and ate their eggs. Within 80 years, the dodo was gone forever.
    - content: The extinction of the dodo is the archetypal example of human-induced
        extinction. It teaches us the extreme vulnerability of island ecosystems
        and the devastating impact of invasive species. Today, we must actively monitor
        and protect isolated habitats.
  interactionParticles: {fileID: 6626796376648807100, guid: 9b5717009b11ee94aa6720fd2f3565c4, type: 3}
  releaseGrabberOnTrigger: 1
  onTrigger:
    m_PersistentCalls:
      m_Calls: []
  autoResetOnLeave: 0
  resetDistance: 10
