  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRExhibitTrigger
  audioSource: {fileID: 0}
  narrationClip: {fileID: 8300000, guid: ba34904ba5950424cbc4f6f1dad44615, type: 3}
  exhibitPanel: {fileID: 1587499140}
  exhibitStory: {fileID: 11400000, guid: 26f79181ef4b3a04489148aab73261cf, type: 2}
  animalData:
    animalName: Woolly Mammoth
    scientificName: Mammuthus primigenius
    status: EXTINCT
    pages:
    - content: 'The Woolly Mammoth was a massive, shaggy relative of modern elephants,
        adapted to the freezing temperatures of the last Ice Age. Covered in dense
        brown fur and a thick layer of fat, it possessed curved tusks up to 4 meters
        long for scraping snow off grass.

'
    - content: As the Ice Age ended, the mammoth's grassland habitat shrank, replaced
        by forests and tundra. At the same time, expanding human populations hunted
        them for meat, bones, and ivory. The combination of rapid climate change
        and human hunting pressure proved fatal.
    - content: "The mammoth's loss demonstrates how climate shifts can destabilize
        species, especially when compounded by human hunting. It shows that species
        adapted to narrow environmental niches are highly vulnerable to rapid climate
        changes\u2014a warning for biodiversity in our warming world today.\r\n"
  interactionParticles: {fileID: 3220580318672070478, guid: 17ec6180e2fd06c448ecd75d6ebef9c9, type: 3}
  releaseGrabberOnTrigger: 1
  onTrigger:
    m_PersistentCalls:
      m_Calls: []
  autoResetOnLeave: 0
  resetDistance: 10
